{
  "name": "ohooks",
  "version": "0.0.1",
  "private": true,
  "description": "Production-ready, SSR-safe collection of modern React 19 hooks written in TypeScript.",
  "keywords": [
    "custom-hooks",
    "hooks",
    "nextjs",
    "react",
    "react-19",
    "react-hooks",
    "ssr",
    "typescript"
  ],
  "homepage": "https://github.com/outslept/ohooks#readme",
  "bugs": {
    "url": "https://github.com/outslept/ohooks/issues"
  },
  "license": "MIT",
  "author": {
    "name": "outslept",
    "url": "https://github.com/outslept"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outslept/ohooks.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest --project=chromium",
    "test:coverage": "vitest run --reporter=dot --coverage --project=chromium",
    "test:ui": "vitest --project=chromium --browser.headless=false",
    "verify": "node scripts/verify-registry.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@pierre/highlights": "^0.5.2",
    "cn": "^0.5.2",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.4",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-istanbul": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "fumadocs-typescript": "^5.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.29.0"
  },
  "packageManager": "pnpm@11.29.0"
}
